use std::io::{self, BufRead};
use std::collections::HashMap;

// --- TASK: MIGRATORY BIRDS ---
fn migratory_birds(arr: &[i32]) -> i32 {
    let mut counts = HashMap::new();
    for &id in arr {
        *counts.entry(id).or_insert(0) += 1;
    }

    let mut max_freq = 0;
    let mut result_id = i32::MAX;

    for (id, freq) in counts {
        if freq > max_freq {
            max_freq = freq;
            result_id = id;
        } else if freq == max_freq && id < result_id {
            result_id = id;
        }
    }
    result_id
}

// --- TASK: STAIRCASE ---
fn staircase(n: i32) {
    for i in 1..=n {
        let spaces = " ".repeat((n - i) as usize);
        let hashes = "#".repeat(i as usize);
        println!("{}{}", spaces, hashes);
    }
}

// --- TASK: GRADING STUDENTS ---
fn grading_students(grades: &[i32]) -> Vec<i32> {
    grades.iter().map(|&g| {
        if g >= 38 && g % 5 >= 3 { g + (5 - g % 5) } else { g }
    }).collect()
}

// --- TASK: BREAKING THE RECORDS ---
fn breaking_records(scores: &[i32]) -> Vec<i32> {
    if scores.is_empty() { return vec![0, 0]; }
    let (mut min, mut max) = (scores[0], scores[0]);
    let (mut min_c, mut max_c) = (0, 0);
    for &s in scores.iter().skip(1) {
        if s > max { max = s; max_c += 1; }
        else if s < min { min = s; min_c += 1; }
    }
    vec![max_c, min_c]
}

fn main() {
    let stdin = io::stdin();
    let mut lines = stdin.lock().lines();

    // Standard reading for Migratory Birds
    if let Some(Ok(_n_line)) = lines.next() {
        if let Some(Ok(arr_line)) = lines.next() {
            let arr: Vec<i32> = arr_line
                .split_whitespace()
                .filter_map(|s| s.parse().ok())
                .collect();
            
            // Calling the migratory_birds function
            println!("{}", migratory_birds(&arr));
        }
    }
}
